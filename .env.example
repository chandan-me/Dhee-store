# =====================================================================
# Central Database & Authentication Configuration Template
# Copy this file to '.env' and specify your actual credentials.
# All passwords and secret keys must be stored in '.env' only.
# =====================================================================

# MySQL Server Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=

# JWT Token Security (Use a 256-bit cryptographically secure key)
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=300000

# Razorpay Payment Gateway Credentials (Optional, for online payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Administrative & Customer Initial Accounts (Optional)
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@store.com
ADMIN_PASSWORD=
CUSTOMER_NAME=Customer User
CUSTOMER_EMAIL=customer@store.com
CUSTOMER_PASSWORD=


